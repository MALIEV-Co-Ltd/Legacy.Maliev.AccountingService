<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ApprovedAccountingRoot)/Legacy.Maliev.AccountingService.Data/Legacy.Maliev.AccountingService.Data.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>
  <Target Name="RequireApprovedSourceRoot" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ApprovedAccountingRoot)' == ''" Text="The exact approved original Accounting source root is required." />
  </Target>
</Project>
